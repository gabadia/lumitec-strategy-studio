# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# MCP server (already running as part of Lumitec stack)
MCP_SERVER_URL=http://localhost:8002/sse

# Port for this backend
PORT=8089

# --- Real command plane (lumitec-desk-cloud, already deployed) -----------
# Single API Gateway base; orchestrator is at the root, strategy_server is
# under /strategies. See lumitec-desk-cloud/OPS_RUNBOOK.md for the current
# invoke URL if this one has changed.
ORCHESTRATOR_URL=https://104m0kfjtc.execute-api.us-east-1.amazonaws.com/api
STRATEGY_SERVER_URL=https://104m0kfjtc.execute-api.us-east-1.amazonaws.com/api/strategies
STRATEGY_SERVER_PUBLISH_PATH=/publish

# Real-time strategy events. Scheme picks the transport:
#   ws:// or wss://  → WebSocket fanout (real deployment, no auth — see
#                      lumitec-desk-ui's src/services/sseClient.ts)
#   http:// or https:// → local SSE gateway (order-strategy-system local dev)
SSE_GATEWAY_URL=wss://events.clouddesk.lumitec.com/

# --- Cognito (Studio's own dedicated app client) --------------------------
COGNITO_USER_POOL_ID=us-east-1_Mv3L9tYpY
COGNITO_REGION=us-east-1
COGNITO_APP_CLIENT_ID=   # fill in after `terraform apply` creates it (module.cognito.studio_user_pool_client_id)

# --- Demo trading identities ----------------------------------------------
# JSON object keyed by Cognito login email. Studio has no live entitlement
# lookup yet (that's a future admin/management application's job) — this is
# a manually-maintained stopgap. Adding a user here does NOT grant them
# access; it only tells Studio what to submit for them. Access itself is
# still enforced by the orchestrator's entitlements table — grant it there
# too via lumitec-desk-cloud/scripts/seed_entitlement.py.
DEMO_USER_ENTITLEMENTS={"guillermo.abadia@lumitec.com":{"account_id":"USA_001","trader_id":"MEMO-DESK","supervisor_ids":["USA-1","SPAIN-1"]}}

# Cognito Hosted UI — Studio's own dedicated app client (see
# lumitec-desk-cloud/terraform/modules/cognito/main.tf). Same user pool and
# hosted domain as lumitec-desk-ui, different client_id.
VITE_COGNITO_DOMAIN=lumitec-demo-cd0054.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=   # fill in after `terraform apply` (module.cognito.studio_user_pool_client_id)
VITE_COGNITO_REDIRECT_URI=http://localhost:5174/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5174/
